{% schema %}
{
  "name": "Final CTA banner",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "info": "Use a line break where you want the heading to wrap — matches the source's \"Got a file?\" / \"Get a price.\" two-line treatment.",
      "default": "Got a file?\nGet a price."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede",
      "default": "<p>Two minutes from upload to an accurate quote — for a single character or a full army.</p>"
    },
    {
      "type": "text",
      "id": "primary_cta_text",
      "label": "Primary button label",
      "default": "Get an instant quote"
    },
    {
      "type": "url",
      "id": "primary_cta_url",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_cta_text",
      "label": "Secondary button label",
      "default": "Browse miniatures"
    },
    {
      "type": "url",
      "id": "secondary_cta_url",
      "label": "Secondary button link"
    },
    {
      "type": "image_picker",
      "id": "art_image_left",
      "label": "Decorative background art (left, optional)",
      "info": "Purely decorative — hidden automatically below 1080px, same as the source design."
    },
    {
      "type": "image_picker",
      "id": "art_image_right",
      "label": "Decorative background art (right, optional)",
      "info": "Purely decorative — hidden automatically below 1080px, same as the source design."
    }
  ],
  "presets": [
    {
      "name": "Final CTA banner"
    }
  ]
}
{% endschema %}
