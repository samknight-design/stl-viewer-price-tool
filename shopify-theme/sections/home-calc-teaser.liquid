{% schema %}
{
  "name": "Calculator teaser",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Instant quote calculator"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "No emails. No waiting."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede",
      "default": "<p>Most print shops make you send a file and wait days for a number. Ours reads your STL the moment you drop it in and prices it on real dimensions — so you know what a project costs before you commit to it.</p>"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button label",
      "default": "Try the calculator"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "No default is set here — Shopify's schema validation rejects both plain path strings and shopify:// resource paths as a url-setting default. Set this to the 3D Print Calculator page in the theme editor after publishing."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Upload your STL files"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Single files or multi-part builds we assemble for you."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Calculator teaser",
      "blocks": [
        { "type": "step", "settings": { "number": "01", "title": "Upload your STL files", "description": "Single files or multi-part builds we assemble for you." } },
        { "type": "step", "settings": { "number": "02", "title": "Pick resin or PLA", "description": "Plus finish, colour and scale — the price updates live." } },
        { "type": "step", "settings": { "number": "03", "title": "Order in one click", "description": "Discounts apply automatically as your basket grows." } }
      ]
    }
  ]
}
{% endschema %}
