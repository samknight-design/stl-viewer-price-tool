{% schema %}
{
  "name": "Spend & save",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Spend more, save more"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Discounts that stack<br />as your army grows.</p>"
    },
    {
      "type": "text",
      "id": "shipping_text",
      "label": "Free shipping flag text",
      "default": "Spend £50 and over for FREE UK shipping"
    },
    {
      "type": "text",
      "id": "terms_text",
      "label": "Terms disclaimer",
      "default": "*Minimum spend requirement does not include postage costs."
    }
  ],
  "blocks": [
    {
      "type": "rung",
      "name": "Discount tier",
      "settings": [
        {
          "type": "number",
          "id": "percent",
          "label": "Discount percent",
          "default": 5
        },
        {
          "type": "text",
          "id": "spend_text",
          "label": "Spend threshold text",
          "default": "Spend £10 and over"
        },
        {
          "type": "range",
          "id": "bar_width",
          "label": "Progress bar fill",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 25
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Spend & save",
      "blocks": [
        { "type": "rung", "settings": { "percent": 5, "spend_text": "Spend £10 and over", "bar_width": 25 } },
        { "type": "rung", "settings": { "percent": 10, "spend_text": "Spend £20 and over", "bar_width": 50 } },
        { "type": "rung", "settings": { "percent": 15, "spend_text": "Spend £30 and over", "bar_width": 75 } },
        { "type": "rung", "settings": { "percent": 20, "spend_text": "Spend £40 and over", "bar_width": 100 } }
      ]
    }
  ]
}
{% endschema %}
