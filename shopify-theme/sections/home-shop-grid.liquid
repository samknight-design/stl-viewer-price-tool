{% schema %}
{
  "name": "Shop grid",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Ready to ship"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pre-printed miniatures."
    },
    {
      "type": "richtext",
      "id": "lede",
      "label": "Lede",
      "default": "<p>Officially licensed designs, printed by us to order — no STL needed.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products shown come from this collection. Leave unset to show an empty-state message instead of a broken grid."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Shop grid"
    }
  ]
}
{% endschema %}
