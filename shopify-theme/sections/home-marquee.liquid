{% schema %}
{
  "name": "Marquee",
  "blocks": [
    {
      "type": "marquee_item",
      "name": "Claim",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Claim text",
          "default": "12K Resin Detail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "marquee_item", "settings": { "text": "12K Resin Detail" } },
        { "type": "marquee_item", "settings": { "text": "Printed To Order" } },
        { "type": "marquee_item", "settings": { "text": "Primed Or Raw" } },
        { "type": "marquee_item", "settings": { "text": "256mm PLA Build Plate" } },
        { "type": "marquee_item", "settings": { "text": "Licensed DM Stash Printer" } },
        { "type": "marquee_item", "settings": { "text": "Free UK Shipping Over £50" } },
        { "type": "marquee_item", "settings": { "text": "Instant STL Pricing" } },
        { "type": "marquee_item", "settings": { "text": "Multi-Part Assembly" } }
      ]
    }
  ]
}
{% endschema %}
