{% schema %}
{
  "name": "Services",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Two ways to print"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Pick your material, we'll handle the rest."
    }
  ],
  "blocks": [
    {
      "type": "service_card",
      "name": "Service card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow",
          "default": "Resin · MSLA"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Miniatures & Characters"
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Body text",
          "default": "<p>Fine detail at small scale. Heroes, villains, monsters and busts, printed in high-detail photopolymer resin.</p>"
        },
        {
          "type": "text",
          "id": "tags",
          "label": "Tags (comma-separated)",
          "info": "Short attributes shown as pill labels, e.g. \"32mm heroic, 12K detail, Primed or raw\"",
          "default": "32mm heroic, 12K detail, Primed or raw"
        },
        {
          "type": "text",
          "id": "cta_text",
          "label": "Link text",
          "default": "Upload for a resin quote"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Services",
      "blocks": [
        {
          "type": "service_card",
          "settings": {
            "eyebrow": "Resin · MSLA",
            "heading": "Miniatures & Characters",
            "body": "<p>Fine detail at small scale. Heroes, villains, monsters and busts, printed in high-detail photopolymer resin.</p>",
            "tags": "32mm heroic, 12K detail, Primed or raw",
            "cta_text": "Upload for a resin quote",
            "cta_url": "shopify://pages/3d-print-calculator"
          }
        },
        {
          "type": "service_card",
          "settings": {
            "eyebrow": "PLA · FDM",
            "heading": "Terrain, Props & Parts",
            "body": "<p>Bigger, tougher builds on a 256mm plate. Terrain, prototypes, gadget housings and custom components.</p>",
            "tags": "256mm plate, 16 colours, Priced by volume",
            "cta_text": "Upload for a PLA quote",
            "cta_url": "shopify://pages/3d-print-calculator"
          }
        }
      ]
    }
  ]
}
{% endschema %}
